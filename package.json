{
  "name": "jesus-ai",
  "version": "1.0.0",
  "description": "AI conversational system that responds as Jesus based on the Bible using RAG",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ingest": "node scripts/ingest.js",
    "ngrok": "node scripts/ngrok-start.js",
    "tunnel": "node scripts/ngrok-start.js",
    "tts:start": "python tts-server/kokoro_server.py --port 8001",
    "tts:install": "pip install -r tts-server/requirements.txt",
    "tts:check": "node -e \"fetch('http://localhost:8001/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Kokoro server not running'))\"",
    "migrate-vectors": "node scripts/migrate-vectors.js",
    "migrate-vectors:force": "node scripts/migrate-vectors.js --force"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "edge-tts": "^1.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "flexsearch": "^0.8.212",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "xml2js": "^0.5.0"
  }
}
