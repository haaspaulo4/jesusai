{
  "name": "jesus-ai",
  "version": "1.0.0",
  "description": "AI conversational system that responds as Jesus based on the Bible using RAG",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pet": "npm start --prefix pet",
    "ingest": "node scripts/ingest.js",
    "lint": "eslint src/ scripts/ tests/",
    "lint:fix": "eslint src/ scripts/ tests/ --fix",
    "format": "prettier --write src/ scripts/ tests/",
    "format:check": "prettier --check src/ scripts/ tests/",
    "ngrok": "node scripts/ngrok-start.js",
    "tunnel": "node scripts/ngrok-start.js",
    "tts:start": "python tts-server/kokoro_server.py --port 8001",
    "tts:install": "pip install -r tts-server/requirements.txt",
    "tts:check": "node -e \"fetch('http://localhost:8001/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Kokoro server not running'))\"",
    "migrate-vectors": "node scripts/migrate-vectors.js",
    "migrate-vectors:force": "node scripts/migrate-vectors.js --force",
    "whisper:start": "python whisper_server.py",
    "whisper:start:small": "set WHISPER_MODEL=small&& python whisper_server.py",
    "whisper:start:medium": "set WHISPER_MODEL=medium&& python whisper_server.py",
    "whisper:start:gpu": "set WHISPER_DEVICE=cuda&& set WHISPER_COMPUTE=float16&& python whisper_server.py",
    "whisper:setup": "scripts\\setup-whisper.bat",
    "whisper:check": "node -e \"fetch('http://localhost:9000/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Whisper server not running on :9000'))\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --forceExit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "edge-tts": "^1.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "flexsearch": "^0.8.212",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.0",
    "reversa": "file:tts-server/reversa",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "xml2js": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
