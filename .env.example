# WordPress
WORDPRESS_URL=http://localhost:8000
WORDPRESS_USER=
WORDPRESS_PASS=

# === VISUAL IDENTITY ===

# Embeddings / Vector Search
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=5000
VECTOR_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.7
TFIDF_WEIGHT=0.3
VECTOR_MIN_SCORE=0.3
VECTOR_AUTO_INDEX=true

# ComfyUI (avatar generation)
COMFYUI_URL=http://localhost:8188

# InstantID (face consistency)
INSTANTID_URL=http://localhost:7860

# LivePortrait (talking avatar)
LIVEPORTRAIT_URL=http://localhost:5000

# Huemint (AI branding)
HUEMINT_URL=https://api.huemint.com