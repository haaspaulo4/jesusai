CRAWL4AI_URL=http://localhost:8000

# YouTube API
YOUTUBE_API_KEY=

# Google Maps Scraper
GOOGLE_MAPS_SCRAPER_URL=http://localhost:8080

# PyTrends (Google Trends) — requires Python server
