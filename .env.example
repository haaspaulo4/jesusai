# Ollama Cloud API (required)
OLLAMA_API_KEY=sua_chave_aqui
OLLAMA_BASE_URL=https://ollama.com/api
CHAT_MODEL=glm-5.1

# Bible API
BIBLE_API_BASE=https://bible-api.com
BIBLE_VERSION=almeida

# Server
PORT=3000

# Database (MySQL 8.4)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jesus_ai

# JWT Auth (required in production)
JWT_SECRET=sua_chave_secreta_aqui

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot (optional)
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_URL=

# WhatsApp Bot - Evolution API v2 (optional)
EVO_API_URL=
EVO_API_KEY=
EVO_INSTANCE=jesus-ai
EVO_WEBHOOK_SECRET=
WHATSAPP_NUMBER=
WHATSAPP_BOT_JID=
WHATSAPP_BOT_PHONE=
WHATSAPP_GROUP_URL=
WHATSAPP_AUDIO=true

# Instagram Bot (optional) — instagram-private-api
IG_USERNAME=
IG_PASSWORD=
IG_PROXY_URL=

# Public URL for webhook callbacks
SERVER_URL=http://localhost:3000

# TTS (Text-to-Speech)
# Mode: "kokoro" (default, local AI) or "multivozes" (API) or "edge-tts" (CLI)
TTS_MODE=kokoro
TTS_VOICE=pm_alex
TTS_RATE=-5%
TTS_PITCH=-2Hz

# Kokoro TTS — hexgrad/Kokoro-82M (Apache 2.0, 82M params, multilingual)
# https://github.com/hexgrad/kokoro
# Start server: python tts-server/kokoro_server.py --port 8000
# Voices: pt-BR (pf_dora, pm_alex), en-US (af_heart, af_bella, af_nova, am_adam, am_michael), es-ES (ef_dora)
# OpenAI voice aliases: alloy, echo, fable, onyx, nova, shimmer
# Requires: pip install kokoro soundfile fastapi uvicorn
KOKORO_URL=http://localhost:8000
KOKORO_LANG=
KOKORO_VOICE=

# Multivozes BR Engine (optional, TTS_MODE=multivozes)
# https://github.com/samucamg/multivozes_br_engine
# OpenAI-compatible TTS API using Microsoft Edge Neural voices
# Self-hosted, free, high-quality voices in pt-BR, en-US, es-ES
MULTIVOZES_URL=
MULTIVOZES_KEY=

# STT (Speech-to-Text)
GROQ_API_KEY=
OPENAI_API_KEY=

# Email / SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3000

# PIX donations
PIX_KEY=seu_email@exemplo.com
PIX_TYPE=email

# === OPEN SOURCE TOOLS ===

# SearXNG (metasearch engine) — https://searxng.org
SEARXNG_URL=http://localhost:8080

# n8n (workflow automation) — https://n8n.io
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Cal.com (scheduling) — https://cal.com
CALCOM_URL=http://localhost:3000

# LibreTranslate (translation) — https://libretranslate.com
LIBRETRANSLATE_URL=http://localhost:5000

# Coqui TTS (open source TTS) — https://coqui.ai
COQUI_URL=http://localhost:5002
COQUI_VOICE=pt_BR

# Redis (cache + rate limiting) — https://redis.io
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

